{
  "permissions": {
    "allow": [
      "Bash(python3 -m unittest discover -s tests)",
      "Bash(python -m unittest discover -s tests)",
      "Bash(node --check *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests.py\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
